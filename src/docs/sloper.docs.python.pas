// The Python client of the Automation API, opensloper.py, written from the
// methods table in Sloper.API.Methods: one Python method per API method, with
// its parameters, types and descriptions, so it never falls behind the server.
// The file is a single module with no dependencies outside the standard
// library, for readers to download beside their scripts. No LCL dependency.
unit Sloper.Docs.Python;

{$mode ObjFPC}{$H+}

interface

const
  PYTHON_CLIENT_TOPIC = 'opensloper.py';
  // Names the client's own methods take, which no API method may have
  PYTHON_CLIENT_RESERVED: array[0..1] of string = ('call', 'close');

// The text of opensloper.py
function PythonClient: string;

implementation

uses
  SysUtils, StrUtils, Sloper.API.Server, Sloper.API.Rpc, Sloper.API.Methods;

const
  REFERENCE_URL = 'https://billbsing.github.io/opensloper/reference/';
  INDENT = '    ';
  LINE_WIDTH = 100;
  // Words Python reserves, which a parameter name gets an underscore after
  PYTHON_KEYWORDS: array[0..34] of string = ('False', 'None', 'True', 'and', 'as', 'assert', 'async', 'await', 'break',
    'class', 'continue', 'def', 'del', 'elif', 'else', 'except', 'finally', 'for', 'from', 'global', 'if', 'import', 'in',
    'is', 'lambda', 'nonlocal', 'not', 'or', 'pass', 'raise', 'return', 'try', 'while', 'with', 'yield');

  PREAMBLE: array[0..44] of string = (
    '# OpenSloper Automation API client for Python',
    '#',
    '# Generated by "opensloper-cli doc opensloper.py" from the program''s own',
    '# table of methods; do not edit it by hand. Copy it beside your script.',
    '#',
    '# Copyright (c) 2026 The OpenSloper authors',
    '# SPDX-License-Identifier: MIT',
    '#',
    '# Permission is hereby granted, free of charge, to any person obtaining a copy',
    '# of this file, to deal in it without restriction, including without',
    '# limitation the rights to use, copy, modify, merge, publish, distribute,',
    '# sublicense, and/or sell copies of it, and to permit persons to whom it is',
    '# furnished to do so, subject to the condition that the above copyright notice',
    '# and this permission notice are included in all copies. THE FILE IS PROVIDED',
    '# "AS IS", WITHOUT WARRANTY OF ANY KIND.',
    '',
    '"""Drive OpenSloper from Python through ``opensloper-cli serve``.',
    '',
    'Each method of :class:`OpenSloper` sends one Automation API request and',
    'returns its result. A refused call raises :class:`OpenSloperError`. Objects',
    'are given by ID (a number) or by name. Formulas are in the pattern''s unit;',
    'positions and lengths in results are in mm.',
    '',
    'Example::',
    '',
    '    from opensloper import OpenSloper',
    '',
    '    with OpenSloper() as sloper:',
    '        sloper.add_point("freePoint", name="A", x="0", y="0")',
    '        print(sloper.evaluate())',
    '',
    'See ' + REFERENCE_URL + 'api/ for every method.',
    '"""',
    '',
    'from __future__ import annotations',
    '',
    'import json',
    'import os',
    'import subprocess',
    'from typing import Any, Literal',
    '',
    '__all__ = ["OpenSloper", "OpenSloperError", "REFUSED", "PARSE_ERROR", "INVALID_REQUEST", "METHOD_NOT_FOUND",',
    '           "INVALID_PARAMS", "INTERNAL_ERROR"]',
    '',
    '# Error codes: a call understood and refused, and the JSON-RPC 2.0 errors');

  Classes: array[0..55] of string = (
    '',
    '',
    'class OpenSloperError(Exception):',
    '    """A refused call, or a server that stopped.',
    '',
    '    Check ``code``, not the message, which may be translated. ``field`` and',
    '    ``position`` say where a formula failed, when the server says so.',
    '    """',
    '',
    '    def __init__(self, code: int, message: str, data: Any = None):',
    '        super().__init__(message)',
    '        self.code = code',
    '        self.message = message',
    '        self.data = data',
    '',
    '    @property',
    '    def field(self) -> str | None:',
    '        return self.data.get("field") if isinstance(self.data, dict) else None',
    '',
    '    @property',
    '    def position(self) -> int | None:',
    '        return self.data.get("position") if isinstance(self.data, dict) else None',
    '',
    '    def __str__(self) -> str:',
    '        where = ""',
    '        if self.field is not None:',
    '            where = f" (field {self.field}"',
    '            if self.position is not None:',
    '                where += f", position {self.position}"',
    '            where += ")"',
    '        return f"{self.message}{where} [{self.code}]"',
    '',
    '',
    'def _target(target: int | str) -> dict[str, Any]:',
    '    """The object a method acts on, by its ID or its name."""',
    '    if isinstance(target, int) and not isinstance(target, bool):',
    '        return {"id": target}',
    '    return {"name": target}',
    '',
    '',
    'def _params(*parts: dict[str, Any]) -> dict[str, Any]:',
    '    """The parts merged, leaving out parameters not given."""',
    '    merged: dict[str, Any] = {}',
    '    for part in parts:',
    '        merged.update((key, value) for key, value in part.items() if value is not None)',
    '    return merged',
    '',
    '',
    'class OpenSloper:',
    '    """A running ``opensloper-cli serve``, with one pattern open at a time.',
    '',
    '    ``program`` is the command line program, by default ``opensloper-cli``',
    '    on the PATH, or the OPENSLOPER_CLI environment variable when it is set.',
    '    Use it in a ``with`` block, or call :meth:`close` when done.',
    '    """',
    '');

  CLIENT_BODY: array[0..40] of string = (
    '    def __init__(self, program: str | None = None, cwd: str | None = None):',
    '        program = program or os.environ.get("OPENSLOPER_CLI", "opensloper-cli")',
    '        self._next_id = 0',
    '        self._server = subprocess.Popen([program, "serve"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,',
    '                                        text=True, encoding="utf-8", cwd=cwd)',
    '',
    '    def __enter__(self) -> OpenSloper:',
    '        return self',
    '',
    '    def __exit__(self, *exc: object) -> None:',
    '        self.close()',
    '',
    '    def close(self) -> None:',
    '        """Stops the server. Changes not saved are lost."""',
    '        if self._server.poll() is None:',
    '            self._server.stdin.close()',
    '            self._server.wait()',
    '',
    '    def call(self, method: str, params: dict[str, Any] | None = None) -> Any:',
    '        """Sends one request and returns its result, for any method by name."""',
    '        self._next_id += 1',
    '        request = {"jsonrpc": "2.0", "id": self._next_id, "method": method, "params": params or {}}',
    '        try:',
    '            self._server.stdin.write(json.dumps(request) + "\n")',
    '            self._server.stdin.flush()',
    '        except (BrokenPipeError, ValueError):',
    '            raise OpenSloperError(INTERNAL_ERROR, "The server has stopped") from None',
    '        line = self._server.stdout.readline()',
    '        if not line:',
    '            raise OpenSloperError(INTERNAL_ERROR, "The server has stopped")',
    '        answer = json.loads(line)',
    '        if "error" in answer:',
    '            error = answer["error"]',
    '            raise OpenSloperError(error.get("code", INTERNAL_ERROR), error.get("message", ""), error.get("data"))',
    '        return answer.get("result")',
    '',
    '    def _send(self, method: str, *parts: dict[str, Any]) -> Any:',
    '        return self.call(method, _params(*parts))',
    '',
    '    # The Automation API methods, in the order of the reference page',
    '');
  ARG_INDENT = INDENT + INDENT + INDENT;

function IsPythonKeyword(const Name: string): boolean;
var
  Keyword: string;
begin
  for Keyword in PYTHON_KEYWORDS do
    if Keyword = Name then
      Exit(True);
  Result := False;
end;

// A parameter's name in Python: the API's name, or the target's
function PythonName(const Param: TApiParam): string;
begin
  if Param.Kind = apTarget then
    Result := 'target'
  else if Param.Kind = apMembers then
    Result := 'members'
  else
    Result := Param.Name;
  if IsPythonKeyword(Result) then
    Result := Result + '_';
end;

// A member of a list or a group, such as marks[].field or axis.edge
function IsSubParam(const Param: TApiParam): boolean;
begin
  Result := (Pos('.', Param.Name) > 0) and (Param.Kind <> apMembers);
end;

function LiteralType(const Choices: string): string;
var
  Choice: string;
begin
  Result := '';
  for Choice in SplitString(Choices, ',') do
    if Trim(Choice) <> '' then
    begin
      if Result <> '' then
        Result := Result + ', ';
      Result := Result + '"' + Trim(Choice) + '"';
    end;
  Result := 'Literal[' + Result + ']';
end;

function PythonType(const Param: TApiParam): string;
begin
  case Param.Kind of
    apTarget, apReference, apMaterial: Result := 'int | str';
    apText: Result := 'str';
    apNumber: Result := 'float';
    apWhole: Result := 'int';
    apFlag: Result := 'bool';
    apFormula: Result := 'str | float';
    apReferences: Result := 'list[int | str]';
    apChoice: Result := LiteralType(Param.Choices);
    apNames: Result := 'list[' + LiteralType(Param.Choices) + ']';
    apList: Result := 'list[dict[str, Any]]';
    apGroup: Result := 'dict[str, Any]';
    else
      Result := 'Any';
  end;
end;

// Text from the methods table for a docstring: Markdown links to other
// reference pages become their address, and nothing can end the docstring
function DocText(const Text: string): string;
var
  Start, Middle, Finish: integer;
  Page: string;
begin
  Result := StringReplace(Text, '\', '\\', [rfReplaceAll]);
  Result := StringReplace(Result, '"""', '\"\"\"', [rfReplaceAll]);
  Start := Pos('[', Result);
  while Start > 0 do
  begin
    Middle := PosEx('](', Result, Start);
    Finish := PosEx('.md)', Result, Middle);
    if (Middle = 0) or (Finish = 0) then
      Break;
    Page := Copy(Result, Middle + 2, Finish - Middle - 2);
    Result := Copy(Result, 1, Start - 1) + Copy(Result, Start + 1, Middle - Start - 1) + ' (' + REFERENCE_URL + Page + '/)' +
      Copy(Result, Finish + 4, MaxInt);
    Start := PosEx('[', Result, Start + 1);
  end;
end;

// Text as docstring lines of at most LINE_WIDTH characters: the first indented
// by LineIndent, the rest by Hanging more
function Wrapped(const Text, LineIndent, Hanging: string): string;
var
  word, Line, Current: string;
begin
  Result := '';
  Line := '';
  Current := LineIndent;
  for word in SplitString(Text, ' ') do
  begin
    if (Line <> '') and (Length(Current) + Length(Line) + 1 + Length(word) > LINE_WIDTH) then
    begin
      Result := Result + Current + Line + LineEnding;
      Line := '';
      Current := LineIndent + Hanging;
    end;
    if Line <> '' then
      Line := Line + ' ';
    Line := Line + word;
  end;
  if Line <> '' then
    Result := Result + Current + Line + LineEnding;
end;

function WithStop(const Text: string): string;
begin
  Result := Text;
  if (Result <> '') and not (Result[Length(Result)] in ['.', '?', '!']) then
    Result := Result + '.';
end;

// The def line, or one parameter a line when that is too long
function MethodSignature(const Method: TApiMethod): string;
var
  Param: TApiParam;
  Members: boolean;
  Required, Optional, Parts: array of string;
  Part, OneLine: string;
begin
  Members := False;
  Required := ['self'];
  Optional := nil;
  for Param in Method.Params do
    if IsSubParam(Param) then
      Continue
    else if Param.Kind = apMembers then
      Members := True
    else if Param.Required then
      Insert(PythonName(Param) + ': ' + PythonType(Param), Required, Length(Required))
    else
      Insert(PythonName(Param) + ': ' + PythonType(Param) + ' | None = None', Optional, Length(Optional));
  Parts := Required;
  if Length(Optional) > 0 then
  begin
    Insert('*', Parts, Length(Parts));
    Insert(Optional, Parts, Length(Parts));
  end;
  if Members then
    Insert('**members: Any', Parts, Length(Parts));
  OneLine := INDENT + 'def ' + Method.Name + '(' + string.Join(', ', Parts) + ') -> Any:';
  if Length(OneLine) <= LINE_WIDTH then
    Exit(OneLine + LineEnding);
  Result := INDENT + 'def ' + Method.Name + '(' + LineEnding;
  for Part in Parts do
    Result := Result + INDENT + INDENT + Part + ',' + LineEnding;
  Result := Result + INDENT + ') -> Any:' + LineEnding;
end;

function MethodDocstring(const Method: TApiMethod): string;
var
  Param: TApiParam;
  Line: string;
begin
  Result := Wrapped('"""' + DocText(Method.Summary), INDENT + INDENT, '');
  if Length(Method.Params) > 0 then
  begin
    Result := Result + LineEnding + INDENT + INDENT + 'Args:' + LineEnding;
    for Param in Method.Params do
    begin
      if IsSubParam(Param) then
        Line := Param.Name
      else if Param.Kind = apMembers then
        Line := '**members'
      else
        Line := PythonName(Param);
      Line := Line + ': ' + WithStop(DocText(Param.Description));
      if IsSubParam(Param) and Param.Required then
        Line := Line + ' Required.';
      Result := Result + Wrapped(Line, ARG_INDENT, INDENT);
    end;
  end;
  Result := Result + LineEnding + INDENT + INDENT + 'Returns:' + LineEnding + Wrapped(WithStop(DocText(Method.Returns)), ARG_INDENT, '');
  Result := Result + INDENT + INDENT + '"""' + LineEnding;
end;

function MethodBody(const Method: TApiMethod): string;
var
  Param: TApiParam;
  Parts, Named: string;
begin
  Parts := '';
  Named := '';
  for Param in Method.Params do
    if IsSubParam(Param) then
      Continue
    else if Param.Kind = apTarget then
      Parts := Parts + ', _target(target)'
    else if Param.Kind = apMembers then
      Parts := Parts + ', members'
    else
      Named := Named + INDENT + INDENT + INDENT + '"' + Param.Name + '": ' + PythonName(Param) + ',' + LineEnding;
  if Named <> '' then
    Parts := Parts + ', {' + LineEnding + Named + INDENT + INDENT + '}';
  Result := INDENT + INDENT + 'return self._send("' + Method.Name + '"' + Parts + ')' + LineEnding;
end;

function Lines(const Text: array of string): string;
var
  Line: string;
begin
  Result := '';
  for Line in Text do
    Result := Result + Line + LineEnding;
end;

function PythonClient: string;
var
  Method: TApiMethod;
begin
  Result := Lines(PREAMBLE);
  Result := Result + Format('REFUSED = %d', [RPC_REFUSED]) + LineEnding + Format('PARSE_ERROR = %d', [RPC_PARSE_ERROR]) +
    LineEnding + Format('INVALID_REQUEST = %d', [RPC_INVALID_REQUEST]) + LineEnding +
    Format('METHOD_NOT_FOUND = %d', [RPC_METHOD_NOT_FOUND]) + LineEnding + Format('INVALID_PARAMS = %d', [RPC_INVALID_PARAMS]) +
    LineEnding + Format('INTERNAL_ERROR = %d', [RPC_INTERNAL_ERROR]) + LineEnding;
  Result := Result + Lines(Classes) + Lines(CLIENT_BODY);
  for Method in ApiMethods do
    Result := Result + MethodSignature(Method) + MethodDocstring(Method) + MethodBody(Method) + LineEnding;
  // The last method ends the file with one line end
  Result := TrimRight(Result) + LineEnding;
end;

end.

<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="OSClipper2"/>
    <Type Value="RunTimeOnly"/>
    <Author Value="Angus Johnson (Clipper2); package wrapper by the OpenSloper authors"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <OtherUnitFiles Value="../../packages/clipper2/Delphi/Clipper2Lib"/>
        <IncludeFiles Value="../../packages/clipper2/Delphi/Clipper2Lib"/>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Other>
        <Verbosity>
          <ShowHints Value="False"/>
          <ShowWarn Value="False"/>
          <ShowNotes Value="False"/>
        </Verbosity>
      </Other>
    </CompilerOptions>
    <Description Value="Clipper2 polygon offsetting and booleans, built from the packages/clipper2 submodule as its own package so its units and warnings stay out of the OpenSloper projects. Clipper.Triangulation is left out: it does not compile with FPC 3.2.2."/>
    <License Value="Boost Software License 1.0"/>
    <Version Major="2"/>
    <Files>
      <Item>
        <Filename Value="../../packages/clipper2/Delphi/Clipper2Lib/Clipper.pas"/>
        <UnitName Value="Clipper"/>
      </Item>
      <Item>
        <Filename Value="../../packages/clipper2/Delphi/Clipper2Lib/Clipper.Core.pas"/>
        <UnitName Value="Clipper.Core"/>
      </Item>
      <Item>
        <Filename Value="../../packages/clipper2/Delphi/Clipper2Lib/Clipper.Engine.pas"/>
        <UnitName Value="Clipper.Engine"/>
      </Item>
      <Item>
        <Filename Value="../../packages/clipper2/Delphi/Clipper2Lib/Clipper.Offset.pas"/>
        <UnitName Value="Clipper.Offset"/>
      </Item>
      <Item>
        <Filename Value="../../packages/clipper2/Delphi/Clipper2Lib/Clipper.Minkowski.pas"/>
        <UnitName Value="Clipper.Minkowski"/>
      </Item>
      <Item>
        <Filename Value="../../packages/clipper2/Delphi/Clipper2Lib/Clipper.RectClip.pas"/>
        <UnitName Value="Clipper.RectClip"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>

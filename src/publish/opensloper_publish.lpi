<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="OpenSloper Publish"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <Icon Value="0"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="OSClipper2"/>
        <DefaultFilename Value="../core/clipper2/osclipper2.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="BGRABitmapPack"/>
        <DefaultFilename Value="../packages/bgrabitmap/bgrabitmap/bgrabitmappack.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="opensloper_publish.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="sloper.publish.mainform.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Sloper.Publish.MainForm"/>
      </Unit>
      <Unit>
        <Filename Value="sloper.publish.previewcanvas.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Sloper.Publish.PreviewCanvas"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="../../release/opensloper-publish"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="../core;../output;../ui"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
      </Debugging>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
    <Other>
      <CustomOptions Value="-FcUTF8"/>
    </Other>
  </CompilerOptions>
</CONFIG>

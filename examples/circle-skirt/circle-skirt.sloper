{
  "format": "pattern",
  "version": 1,
  "units": "cm",
  "notes": "A knee-length full circle skirt with a buttoned waistband, drafted from the waist with arcs. Each skirt piece is a quarter circle cut on the fold, so the two make a full circle. Example pattern: measurements from a size table, arcs, a fold, an edge with its own allowance, notches by distance and a button marker.",
  "measurementFile": "../measurements/size-table.slm",
  "identity": "598d736b-ca68-4855-a9d7-1ab559bb90b7",
  "nextId": 33,
  "variables": [
    {
      "id": 1,
      "name": "waist_ease",
      "formula": "1",
      "description": "Ease at the waist"
    },
    {
      "id": 2,
      "name": "band_width",
      "formula": "4",
      "description": "Finished width of the waistband"
    },
    {
      "id": 3,
      "name": "overlap",
      "formula": "3",
      "description": "Waistband overlap for the button"
    },
    {
      "id": 4,
      "name": "length",
      "formula": "@waist_to_knee - {2}",
      "description": "Skirt length below the waistband"
    },
    {
      "id": 5,
      "name": "waist_radius",
      "formula": "(@waist_circumference + {1}) / (2 * 3.14159265)",
      "description": "Radius of the waist circle: its circumference is the waist with ease"
    }
  ],

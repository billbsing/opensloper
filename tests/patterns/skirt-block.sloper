{
  "format": "pattern",
  "version": 1,
  "units": "mm",
  "notes": "Straight skirt block, half back and front. A regression pattern: it uses every operation.",
  "measurementFile": "skirt-small.slm",
  "variables": [
    {
      "id": 1,
      "name": "hip_ease",
      "formula": "40",
      "description": "Total ease at the hip"
    },
    {
      "id": 2,
      "name": "waist_ease",
      "formula": "10",
      "description": "Total ease at the waist"
    },
    {
      "id": 3,
      "name": "suppression",
      "formula": "(@hip + {1} - @waist - {2}) / 2",
      "description": "Waist shaping for the half skirt: side seam, back dart and front dart"
    },
    {
      "id": 4,
      "name": "side_take",
      "formula": "{3} / 4",
      "description": "Taken in at the side, on each panel"
    },
    {
      "id": 5,
      "name": "back_dart",
      "formula": "{3} * 0.3",
      "description": "Back dart width"
    },
    {
      "id": 6,
      "name": "front_dart",
      "formula": "{3} * 0.2",
      "description": "Front dart width"
    }
  ],
  "objects": [
    {
      "id": 7,
      "type": "freePoint",
      "name": "A",
      "x": "0",
      "y": "0"
    },
    {
      "id": 8,
      "type": "offsetPoint",
      "name": "B",
      "base": 7,
      "mode": "polar",
      "length": "@waist_to_hip",
      "angle": "270"
    },
    {
      "id": 9,
      "type": "offsetPoint",
      "name": "C",
      "base": 7,
      "mode": "polar",
      "length": "@skirt_length",
      "angle": "270"
    },
    {
      "id": 10,
      "type": "offsetPoint",
      "name": "D",
      "base": 7,
      "mode": "polar",
      "length": "@hip / 2 + {1} / 2",
      "angle": "0"
    },
    {
      "id": 11,
      "type": "line",
      "name": "Waist_line",
      "start": 7,
      "end": 10,
      "role": "construction"
    },
    {
      "id": 12,
      "type": "offsetPoint",
      "name": "E",
      "base": 8,
      "mode": "polar",
      "length": "{11}.length",
      "angle": "0"
    },
    {
      "id": 13,

<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="opensloper_tests"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="OSClipper2"/>
        <DefaultFilename Value="../src/core/clipper2/osclipper2.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="opensloper_tests.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="ostestcase.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="osTestCase"/>
      </Unit>
      <Unit>
        <Filename Value="testgeometry.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestGeometry"/>
      </Unit>
      <Unit>
        <Filename Value="testapppaths.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestAppPaths"/>
      </Unit>
      <Unit>
        <Filename Value="testclipper.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="TestClipper"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="opensloper_tests"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="../src/core;../src/document"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <CodeGeneration>
      <Checks>
        <IOChecks Value="True"/>
        <RangeChecks Value="True"/>
        <OverflowChecks Value="True"/>
        <StackChecks Value="True"/>
      </Checks>
    </CodeGeneration>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
        <UseHeaptrc Value="True"/>
        <TrashVariables Value="True"/>
        <UseExternalDbgSyms Value="False"/>
      </Debugging>
    </Linking>
    <Other>
      <CustomOptions Value="-Sa"/>
    </Other>
  </CompilerOptions>
</CONFIG>

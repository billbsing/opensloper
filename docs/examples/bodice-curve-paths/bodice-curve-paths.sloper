{
  "format": "pattern",
  "version": 1,
  "units": "cm",
  "notes": "A simplified bodice block, half back and half front, each cut on the fold, with a waist dart in each. A starting point for tops and dresses rather than a tested fit. Example pattern: curves square to the shoulder, curve paths for the armholes, darts, notches, and seams checked for length, with ease on the shoulder.",
  "measurementFile": "../measurements/size-table.slm",
  "identity": "a7ed61eb-4f5c-4f77-a68a-e82ec3ad1669",
  "nextId": 57,
  "variables": [
    {
      "id": 1,
      "name": "bust_ease",
      "formula": "8",
      "description": "Total ease at the bust"
    },
    {
      "id": 2,
      "name": "waist_ease",
      "formula": "4",
      "description": "Total ease at the waist"
    },
    {
      "id": 3,
      "name": "half_width",
      "formula": "@bust_circumference / 4 + {1} / 4",
      "description": "Width of each half piece at the bust"
    },
    {
      "id": 4,
      "name": "scye_depth",
      "formula": "@bust_circumference / 8 + 9",
      "description": "From the back neck down to the underarm"
    },
    {
      "id": 5,
      "name": "neck_width",
      "formula": "@neck_circumference / 5 - 0.2",
      "description": "Centre to neck side point"
    },
    {
      "id": 6,
      "name": "shaping",
      "formula": "{3} - (@waist_circumference / 4 + {2} / 4)",
      "description": "Taken out at the waist on each half piece, at the side and in the dart"
    },
    {
      "id": 7,
      "name": "side_shaping",
      "formula": "{6} * 0.4",
      "description": "Taken in at each side seam"
    },
    {
      "id": 8,
      "name": "dart",
      "formula": "{6} * 0.6",
      "description": "Width of each waist dart"
    },
    {
      "id": 9,
      "name": "shoulder_ease",
      "formula": "1",
      "description": "Back shoulder length more than the front, eased in"
    }
  ],

{
  "format": "pattern",
  "version": 1,
  "units": "mm",
  "notes": "A straight skirt block: half back and half front. The pattern of the straight skirt tutorial.",
  "measurementFile": "skirt.slm",
  "nextId": 48,
  "variables": [
    {
      "id": 1,
      "name": "hip_ease",
      "formula": "40",
      "description": "Ease added round the hip"
    },
    {
      "id": 2,
      "name": "waist_ease",
      "formula": "10",
      "description": "Ease added round the waist"
    },
    {
      "id": 3,
      "name": "half_hip",
      "formula": "@hip / 2 + {1} / 2",
      "description": "Half the hip, with its ease: the width of the block"
    },
    {
      "id": 4,
      "name": "back_hip",
      "formula": "{3} / 2 - 10",
      "description": "The back's width at the hip; the side seam sits 10 mm towards the back"
    },
    {
      "id": 5,
      "name": "front_hip",
      "formula": "{3} - {4}",
      "description": "The front's width at the hip"
    },
    {
      "id": 6,
      "name": "suppression",
      "formula": "(@hip + {1} - @waist - {2}) / 2",
      "description": "How much the half skirt narrows from hip to waist"
    },
    {
      "id": 7,
      "name": "side_take",
      "formula": "{6} / 4",
      "description": "Taken in at the side seam, on each piece"
    },
    {
      "id": 8,
      "name": "back_dart",
      "formula": "{6} * 0.3",
      "description": "Width of the back dart"
    },
    {
      "id": 9,
      "name": "front_dart",
      "formula": "{6} * 0.2",
      "description": "Width of the front dart"
    }
  ],

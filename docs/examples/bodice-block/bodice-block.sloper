{
  "format": "pattern",
  "version": 1,
  "units": "cm",
  "notes": "A close-fitting bodice block: half back and half front, each cut on the fold, with a waist dart in each. The pattern of the bodice block tutorial.",
  "measurementFile": "bodice.slm",
  "identity": "a9d27dd4-466a-4988-a917-5754d4ea4b19",
  "nextId": 71,
  "variables": [
    {
      "id": 1,
      "name": "bust_ease",
      "formula": "8",
      "description": "Ease added round the bust"
    },
    {
      "id": 2,
      "name": "waist_ease",
      "formula": "4",
      "description": "Ease added round the waist"
    },
    {
      "id": 3,
      "name": "half_width",
      "formula": "@bust_circumference / 4 + {1} / 4",
      "description": "Width of each half piece at the bust"
    },
    {
      "id": 4,
      "name": "scye_depth",
      "formula": "@bust_circumference / 8 + 9",
      "description": "From the back neck down to the underarm"
    },
    {
      "id": 5,
      "name": "neck_width",
      "formula": "@neck_circumference / 5 - 0.2",
      "description": "From the centre to the neck point"
    },
    {
      "id": 6,
      "name": "shaping",
      "formula": "{3} - (@waist_circumference / 4 + {2} / 4)",
      "description": "Taken out at the waist on each half, at the side and in the dart"
    },
    {
      "id": 7,
      "name": "side_shaping",
      "formula": "{6} * 0.4",
      "description": "Taken in at each side seam"
    },
    {
      "id": 8,
      "name": "dart",
      "formula": "{6} * 0.6",
      "description": "Width of each waist dart"
    },
    {
      "id": 9,
      "name": "shoulder_ease",
      "formula": "1",
      "description": "How much longer the back shoulder is than the front, eased in"
    }
  ],

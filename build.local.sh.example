# Copy to build.local.sh (gitignored) to use a toolchain that is not on PATH,
# for example an fpcupdeluxe install. Read by every opensloper-make.sh command.
LAZBUILD="$HOME/Packages/fpc_build/lazarus/lazbuild"
LAZARUS_PCP="$HOME/Packages/fpc_build/config_lazarus"
# Formatter source for opensloper-make.sh format. The default is the Lazarus
# that LAZBUILD belongs to; CI formats with the release Lazarus in
# .github/workflows/ci.yml, so only override this with a source that formats
# the same way.
#JCF_SOURCE="$HOME/Packages/fpc_build/lazarus/components/jcf2"
